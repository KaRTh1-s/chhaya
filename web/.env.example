# =============================================================================
# Chhaya Web Frontend - Environment Configuration
# =============================================================================

# 1. Backend API Base URL
# Leave blank ("") to use relative endpoints (/api/...) or client-side mock fallback.
# For deployed AWS environments, set to your API Gateway or ALB endpoint:
# Example: https://api.chhaya.example.com
VITE_API_URL=""

# 2. Live Subsystem Indicators (TopBanner & Ticker status)
# Comma-separated list of active/verified AWS & external services.
# Known IDs: api, bedrock, dynamodb, open-meteo, cams, sns
# - Laptop/Offline/Mock Mode: leave empty ("")
# - Full Production AWS Deployment: api,bedrock,dynamodb,open-meteo,cams,sns
# - Hybrid Dev Deployment: api,open-meteo,cams
VITE_STACK_LIVE=""

# 3. Mock Data Override
# Set to "true" to force deterministic mock replay fixtures even if VITE_API_URL is set.
VITE_USE_MOCK="false"

# =============================================================================
# CORS & Security Note:
# When hosting frontend on S3/CloudFront and backend on API Gateway/FastAPI:
# Ensure backend `CORSMiddleware` allows your CloudFront distribution domain
# (e.g. `https://d1234567890abc.cloudfront.net` or custom domain `https://app.chhaya.org`).
# =============================================================================
